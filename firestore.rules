rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Siapa pun yang login resmi via Firebase Authentication adalah Admin resmi
    function isAuthenticated() {
      return request.auth != null;
    }

    // ========================================================
    // 1. KOLEKSI WEBSITE PORTOFOLIO (SENTUARY)
    // ========================================================

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /live_chat/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 1000;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ========================================================
    // 2. KOLEKSI WEBSITE AIRO 2026 (MURNI DINAMIS & AMAN)
    // ========================================================

    // Tenaga Pengajar: Publik bebas melihat profil & foto SVG, Admin boleh CRUD
    match /pengajar/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Dosen Pembimbing: Publik bebas melihat profil & foto SVG, Admin boleh CRUD
    match /pembimbing/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Berita & Pengumuman: Publik bebas membaca berita, Admin boleh CRUD
    match /berita/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Poster & Media Promosi: Publik bebas melihat poster SVG/WebP, Admin boleh CRUD
    match /posters/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Harga & Paket Layanan (Paket Robotic, dll): Publik bebas melihat, Admin boleh CRUD
    match /layanan/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Koleksi Manajemen Admin & Konfigurasi
    match /admin_users/{userId} {
      allow read, write: if isAuthenticated();
    }
    match /admin_config/{configId} {
      allow read, write: if isAuthenticated();
    }

    // ========================================================
    // 3. DEFAULT FAIL-SAFE (ZERO TRUST)
    // ========================================================
    // Menolak seluruh akses ke dokumen/koleksi lain yang tidak terdaftar secara eksplisit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
