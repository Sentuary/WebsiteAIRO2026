rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Koleksi Pengajar, Pembimbing, dan Berita
    // Dapat dibaca oleh semua pengunjung website (read: true)
    // Dapat ditambah, diedit, atau dihapus oleh admin (write: true)
    match /pengajar/{docId} {
      allow read, write: if true;
    }
    match /pembimbing/{docId} {
      allow read, write: if true;
    }
    match /berita/{docId} {
      allow read, write: if true;
    }

    // 2. Koleksi Admin & Konfigurasi Sistem
    match /admin_users/{userId} {
      allow read, write: if true;
    }
    match /admin_config/{configId} {
      allow read, write: if true;
    }

    // 3. Fallback aturan default
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
